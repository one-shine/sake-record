{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "個人用ローカル設定。.claude/settings.local.json にコピーして使う(gitignore済み)。チーム共有は settings.json へ。",
  "permissions": {
    "allow": [
      "WebFetch(domain:localhost)",
      "Bash(npm run dev*)"
    ]
  },
  "autoMemoryEnabled": true
}
